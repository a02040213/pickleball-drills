<!doctype html>
<html lang="zh-Hant"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.subtitle }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_TW">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.subtitle }}">
<meta property="og:url" content="https://a02040213.github.io/pickleball-drills/">
<meta property="og:image" content="https://a02040213.github.io/pickleball-drills/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<style>{{ css | safe }}</style>
</head><body>
<div class="wrap">

<div class="hero">
  <p class="kicker">{{ site.title_en }}</p>
  <h1>{{ site.title }}</h1>
  <p>{{ site.subtitle }}</p>
</div>

{% if upcoming_sessions or past_sessions %}
<section class="sessions-nav">
  <h2>即將進行的訓練</h2>
  {% if upcoming_sessions %}
  <ul>
    {% for s in upcoming_sessions %}
    <li><a href="schedule/{{ s.date }}.html">{{ s.date }} {{ s.label }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if past_sessions %}
  <details class="past-sessions">
    <summary>過去的訓練</summary>
    <ul>
      {% for s in past_sessions %}
      <li><a href="schedule/{{ s.date }}.html">{{ s.date }} {{ s.label }}</a></li>
      {% endfor %}
    </ul>
  </details>
  {% endif %}
</section>
{% endif %}

<nav class="jump">
  {% for cat in categories %}
  <a href="#cat-{{ cat.code }}">{{ cat.code }} {{ cat.title_zh }}</a>
  {% endfor %}
</nav>

{% for cat in categories %}
<section class="category" id="cat-{{ cat.code }}">
  <div class="category-head">
    <span class="code">{{ cat.code }}</span>
    <h2>{{ cat.title_zh }}</h2>
    <span class="en">{{ cat.title_en }}</span>
  </div>
  <p class="category-focus">訓練重點：{{ cat.focus }}</p>

  {% for drill in cat.drills %}
  <details class="drill" id="drill-{{ drill.id }}">
    <summary class="drill-head">
      <span class="num">{{ drill.id }}</span>
      <h3>{{ drill.title_zh }}</h3>
      <span class="en">{{ drill.title_en }}</span>
    </summary>
    <div class="drill-body">
      <div class="drill-diagram">{{ drill.diagram_svg | safe }}</div>
      <div class="drill-text">
        <h4>訓練方式</h4>
        <ul>
          {% for line in drill.method %}<li>{{ line }}</li>{% endfor %}
        </ul>
        <h4>訓練重點</h4>
        <ul>
          {% for line in drill.points %}<li>{{ line }}</li>{% endfor %}
        </ul>
        {% if drill.note %}<p class="note">{{ drill.note }}</p>{% endif %}
      </div>
    </div>
  </details>
  {% endfor %}
</section>
{% endfor %}

<p class="footer">課表大總表</p>
</div>
</body></html>
